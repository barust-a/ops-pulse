{
  "name": "@ops-pulse/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -b --noEmit",
    "hygiene": "npm run hygiene:knip && npm run hygiene:dup",
    "hygiene:knip": "knip --no-progress",
    "hygiene:dup": "jscpd src --no-tips",
    "hygiene:dup:update": "npm run hygiene:dup -- --update-baseline"
  },
  "dependencies": {
    "echarts": "6.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "7.18.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "6.10.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-unicorn": "65.0.1",
    "globals": "16.5.0",
    "jscpd": "5.4.1",
    "jsdom": "27.4.0",
    "knip": "6.41.0",
    "msw": "2.15.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "4.1.11"
  }
}

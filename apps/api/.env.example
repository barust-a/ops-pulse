# Copy to .env for local development (npm run dev / db:migrate / db:seed load it if present).
# Every value below is a local, throwaway development value: never reuse one outside a dev box.
DATABASE_URL=postgres://ops_pulse:ops_pulse@localhost:5432/ops_pulse
# HS256 signing key, at least 32 characters. Fake dev value: generate a real one per environment.
JWT_SECRET=dev-only-fake-jwt-secret-change-me-0123456789
JWT_TTL_SECONDS=3600
# Comma-separated allow-list of browser origins.
CORS_ORIGIN=http://localhost:5173,http://localhost:8080
PORT=3000
LOG_LEVEL=info
# SAML extension point: when true, SAML_ISSUER, SAML_ENTRY_POINT, SAML_IDP_CERT and
# SAML_CALLBACK_URL are required.
SAML_ENABLED=false
SAML_ENTRY_POINT=
SAML_ISSUER=
SAML_IDP_CERT=
SAML_CALLBACK_URL=
# Seed anchor ("now" for the generated 90 days), ISO date or date-time. Empty: the current time.
SEED_NOW=
# Migrations folder. Empty: <repo>/db/migrations.
MIGRATIONS_DIR=

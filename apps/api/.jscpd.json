{
  "format": ["typescript", "javascript"],
  "minTokens": 70,
  "minLines": 8,
  "ignore": [
    "**/node_modules/**",
    "**/*.d.ts",
    "**/*.generated.*",
    "**/*.test.ts",
    "**/testing/**"
  ],
  "reporters": ["ai"],
  "failOnEmpty": true,
  "baseline": ".jscpd-baseline.json",
  "failOnNewClones": 0
}

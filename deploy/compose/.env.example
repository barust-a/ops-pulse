# Ops Pulse — Docker Compose environment (deploy/compose/).
# Copy to deploy/compose/.env (git-ignored) and adjust:
#   cp deploy/compose/.env.example deploy/compose/.env
#
# !!! FAKE, DEVELOPMENT-ONLY VALUES. NEVER USE THEM OUTSIDE A LAPTOP. !!!
# On staging/production every secret comes from the host's protected .env (mode 600, owned by
# root) or a vault; generate them with: openssl rand -base64 48

# ---- Images (local builds by default; deploy.sh sets these for registry images) ----
OPS_PULSE_IMAGE_PREFIX=ops-pulse
OPS_PULSE_TAG=local

# ---- PostgreSQL ----
POSTGRES_DB=ops_pulse
POSTGRES_USER=ops_pulse
POSTGRES_PASSWORD=dev-only-not-a-secret

# ---- API ----
# Must be at least 32 characters. Dev-only placeholder:
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789abcdef
JWT_TTL_SECONDS=3600
CORS_ORIGIN=http://localhost:8080
LOG_LEVEL=info
SAML_ENABLED=false
SAML_ENTRY_POINT=
SAML_ISSUER=
SAML_IDP_CERT=

# ---- Demo data ----
# true loads the deterministic seed (demo users, incidents, changes). Always false in production.
SEED_DEMO_DATA=true

# ---- Web ----
WEB_PORT=8080

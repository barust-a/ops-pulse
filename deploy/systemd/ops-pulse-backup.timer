# Backs the database up every day at 05:30 Paris time, before the 06:00 KPI job rewrites
# ops.daily_service_kpis.

[Unit]
Description=Daily 05:30 Ops Pulse database backup

[Timer]
OnCalendar=*-*-* 05:30:00 Europe/Paris
Persistent=true
AccuracySec=1min
Unit=ops-pulse-backup.service

[Install]
WantedBy=timers.target

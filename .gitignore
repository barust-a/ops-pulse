# Dependencies and build output
node_modules/
.npm/
dist/
coverage/
reports/
*.tsbuildinfo

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.uv-cache/
.coverage
coverage.xml

# Environment files: secrets never enter git; the example files do
.env
.env.*
!.env.example
!**/.env.example

# Deployment state and backups (created on servers by deploy/scripts/)
.deploy/
*.dump
*.dump.partial

# Logs and OS files
*.log
.DS_Store

# Claude Code: local overrides and agent worktrees stay out of git
.claude/settings.local.json
.claude/worktrees/
